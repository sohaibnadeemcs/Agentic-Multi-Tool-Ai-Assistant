# Copy this file to .env and fill in your keys. Never commit the real .env file.

# --- Required API keys (both have free tiers) ---
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# --- Model ---
GROQ_MODEL=llama-3.3-70b-versatile

# --- Pollinations (keyless free image API, override only if needed) ---
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# --- Storage (defaults are fine for local/docker use) ---
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_PATH=./data/sqlite/chat_history.db

# --- Memory / RAG tuning ---
MEMORY_TOP_K=4
RAG_TOP_K=4
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
BACKEND_URL=http://localhost:8000
